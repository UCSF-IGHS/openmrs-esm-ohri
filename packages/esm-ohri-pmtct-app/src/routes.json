{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": "^2.24.0"
  },
  "pages": [],
  "extensions": [
    {
      "name": "pmtct-status-banner-tag",
      "slot": "patient-banner-tags-slot",
      "component": "pmtctBannerTagExtension"
